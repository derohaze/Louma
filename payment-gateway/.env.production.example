# Copy to .env.production locally, or paste the filled values into Coolify.
# These are RUNTIME secrets, never Docker build arguments.
GATEWAY_ENVIRONMENT=live
GATEWAY_ADDRESS=0.0.0.0:8090
# Same production replica set/database as the Node backend; URI must use TLS.
GATEWAY_MONGODB_URI=
GATEWAY_DATABASE=louma
GATEWAY_PUBLIC_URL=https://checkout.loumapay.com
GATEWAY_DASHBOARD_URL=https://app.loumapay.com
# Generate every secret separately with crypto.randomBytes(32).toString('hex').
# GATEWAY_SERVICE_KEY must also be PAYMENT_GATEWAY_LIVE_SERVICE_KEY in Node.
GATEWAY_SERVICE_KEY=
GATEWAY_API_KEY_PEPPER=
GATEWAY_ENCRYPTION_KEY=
# Bundled private Redis. Set URL to redis://default:<password>@gateway-redis:6379/0.
# Enter a full URL; do not rely on nested env-variable expansion in Coolify.
GATEWAY_REDIS_PASSWORD=
GATEWAY_REDIS_URL=
GATEWAY_FEE_VERSION=2026-10-08
GATEWAY_FEE_BASIS_POINTS=100
# Set true only after backup, compatible Node schema, migration and reconciliation.
GATEWAY_LIVE_ENABLED=false
GATEWAY_CREATION_PAUSED=false
GATEWAY_SETTLEMENT_PAUSED=false
GATEWAY_BILLING_PAUSED=false
GATEWAY_MERCHANT_PAUSED=false
# Keep empty to preserve Docker service discovery.
GATEWAY_DNS_SERVERS=
# REQUIRED by production Compose. Inspect the actual Coolify proxy network.
# Example syntax only: 172.20.0.2/32. Do not copy an unverified subnet.
GATEWAY_TRUSTED_PROXY_CIDRS=
# Starting budget per Go process: 512 MiB container, 384 MiB Go soft heap limit.
GOMEMLIMIT=384MiB
GOGC=100
