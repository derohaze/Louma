# Development template: copy to .env.development. Never commit real keys.
# Run ./run-local.ps1 dev api (worker in a second terminal).
# Node and Go must share this sandbox database; never use the live database.
GATEWAY_ENVIRONMENT=test
GATEWAY_ADDRESS=127.0.0.1:8090
GATEWAY_MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
GATEWAY_DATABASE=louma_gateway_test_dev
# Optional locally: empty uses the bounded in-process limiter.
GATEWAY_REDIS_URL=
GATEWAY_PUBLIC_URL=http://localhost:8090
GATEWAY_DASHBOARD_URL=http://localhost:3000
# Generate each separately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Service key must match PAYMENT_GATEWAY_TEST_SERVICE_KEY in the Node backend.
GATEWAY_SERVICE_KEY=
GATEWAY_API_KEY_PEPPER=
GATEWAY_ENCRYPTION_KEY=
GATEWAY_FEE_VERSION=2026-10-08
GATEWAY_FEE_BASIS_POINTS=100
GATEWAY_LIVE_ENABLED=false
GATEWAY_CREATION_PAUSED=false
GATEWAY_SETTLEMENT_PAUSED=false
GATEWAY_BILLING_PAUSED=false
GATEWAY_MERCHANT_PAUSED=false
# Empty uses system DNS. Local SRV workaround only: 1.1.1.1,9.9.9.9.
GATEWAY_DNS_SERVERS=
# Empty trusts no forwarded IP headers. Never trust all IPs.
GATEWAY_TRUSTED_PROXY_CIDRS=
GOMEMLIMIT=384MiB
GOGC=100
