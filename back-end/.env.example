# Louma customer API — Coolify environment template.
# Copy these keys into the Coolify service's Environment Variables.
# Generate the two 32-byte keys with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Run it twice: once for ACCESS_TOKEN_SECRET, once for APP_ENCRYPTION_KEY.

NODE_ENV=production
# Dockerfile already sets HOST=0.0.0.0 and LOUMA_API_PORT=8000; override here only if needed.
HOST=0.0.0.0
LOUMA_API_PORT=8000

# --- Required ---
MONGODB_URI=mongodb+srv://user:password@cluster.example.net/?retryWrites=true&w=majority
MONGODB_DATABASE=louma
ACCESS_TOKEN_SECRET=REPLACE-WITH-BASE64-32-BYTE-KEY
APP_ENCRYPTION_KEY=REPLACE-WITH-BASE64-32-BYTE-KEY
# Public URL(s) of the Vercel frontend, comma-separated, no paths. Same-origin
# Vercel rewrites proxy /api, so this is the browser origin, e.g.:
FRONTEND_ORIGINS=https://your-app.vercel.app

# --- Recommended on Coolify ---
# Coolify sits behind a reverse proxy: name it so registration IPs and rate
# limits see the real client, not the proxy. Use the proxy's address/CIDR.
# Leave unset only if the API terminates connections itself.
# TRUST_PROXY=10.0.0.0/8
# Optional Redis (cache + distributed rate limits). Unset = MongoDB-only, still correct.
# REDIS_URL=redis://default:password@redis-host:6379
LOG_LEVEL=info

# --- Usually left at defaults ---
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=lax
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000
# RETENTION_TTL_ENABLED=false
# IPINFO_TOKEN=
# PROXYCHECK_KEY=
