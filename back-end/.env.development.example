# Louma Node backend + embedded payment gateway. Keep this file private.
# Coolify injects these as runtime values; never bake secrets into the image.
# Generate Node secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Gateway encryption uses hex instead of base64. Preserve existing keys when upgrading.
ACCESS_TOKEN_SECRET="REPLACE_WITH_GENERATED_SECRET"
APP_ENCRYPTION_KEY="REPLACE_WITH_GENERATED_SECRET"
COOKIE_SAME_SITE="lax"
COOKIE_SECURE="false"
FRONTEND_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
HOST="127.0.0.1"
IPINFO_TIMEOUT_MS="2500"
IPINFO_TOKEN=""
LMDG_AMBIGUOUS_MATCH_THRESHOLD="55"
LMDG_BROWSER_KEY_REQUIRED="false"
LMDG_CHALLENGE_TTL_SECONDS="300"
LMDG_DEVICE_LEASE_ENABLED="true"
LMDG_DEVICE_OBSERVATION_TTL_SECONDS="7776000"
LMDG_ENABLED="true"
LMDG_HIGH_CONFIDENCE_MATCH_THRESHOLD="78"
LMDG_IP_INTELLIGENCE_TTL_SECONDS="86400"
LMDG_NONCE_TTL_SECONDS="300"
LMDG_RISK_MODE="enforce"
LOG_LEVEL="debug"
LOUMA_API_PORT="8000"
MINING_CYCLE_DURATION_SECONDS="86400"
MINING_ENABLED="true"
MINING_MAX_ACTIVE_CYCLES_PER_USER="1"
MINING_RATE_DECIMALS="6"
MINING_RATE_MAX_LMA_PER_HOUR="0.0500"
MINING_RATE_MIN_LMA_PER_HOUR="0.0100"
MINING_SETTLEMENT_ENABLED="true"
MONGODB_CONNECT_TIMEOUT_MS="30000"
MONGODB_DATABASE="louma_gateway_test_dev"
MONGODB_SERVER_SELECTION_TIMEOUT_MS="30000"
MONGODB_URI="mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true"
NODE_ENV="development"
PROXYCHECK_HMAC_KEY=""
PROXYCHECK_KEY=""
PROXYCHECK_TIMEOUT_MS="2500"
PROXY_SHARED_SECRET=""
RATE_LIMIT_MAX="120"
RATE_LIMIT_WINDOW_MS="60000"
REDIS_KEY_PREFIX="louma_development"
REDIS_URL="redis://127.0.0.1:6379/0"
RETENTION_TTL_ENABLED="false"
TRUST_PROXY="false"
GATEWAY_API_KEY_PEPPER="REPLACE_WITH_GENERATED_SECRET"
GATEWAY_ENCRYPTION_KEY="REPLACE_WITH_GENERATED_32_BYTE_HEX"
GATEWAY_SERVICE_KEY="REPLACE_WITH_GENERATED_SECRET"
GATEWAY_FEE_BASIS_POINTS="100"
GATEWAY_FEE_VERSION="2026-10-08"
GATEWAY_CREATION_PAUSED="false"
GATEWAY_SETTLEMENT_PAUSED="false"
GATEWAY_BILLING_PAUSED="false"
GATEWAY_MERCHANT_PAUSED="false"
GATEWAY_ENABLED="true"
GATEWAY_ENVIRONMENT="test"
GATEWAY_LIVE_ENABLED="false"
GATEWAY_PUBLIC_URL="http://localhost:8000"
GATEWAY_DASHBOARD_URL="http://localhost:3000"
GATEWAY_RATE_LIMIT="120"
MONGODB_MAX_POOL_SIZE="64"
