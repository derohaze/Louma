{
  "name": "louma-customer-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.development --import tsx -e \"import('node:dns').then(m=>{m.default.setServers(['8.8.8.8','1.1.1.1'])}).then(()=>import('./src/server.ts'))\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env.production dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/config/env.test.ts src/modules/ledger/money.test.ts src/modules/mining/mining.test.ts src/modules/security/csrf.test.ts src/modules/security/crypto.test.ts src/modules/security/access-token.test.ts src/modules/security/totp.test.ts src/modules/security/notification-stream.test.ts src/modules/geo/ipinfo.test.ts",
    "test:integration": "node --env-file-if-exists=.env.development --import \"data:text/javascript,import dns from 'node:dns';dns.setServers(['8.8.8.8','1.1.1.1']);\" --import tsx --test src/tests/database.integration.test.ts",
    "test:integration:mining": "node --env-file-if-exists=.env.development --import \"data:text/javascript,import dns from 'node:dns';dns.setServers(['8.8.8.8','1.1.1.1']);\" --import tsx --test src/tests/mining.integration.test.ts",
    "reconcile:ledger": "node --env-file-if-exists=.env.production dist/scripts/reconcile-ledger.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "argon2": "0.45.1",
    "fastify": "5.12.5",
    "mongodb": "7.6.0",
    "otplib": "13.5.0",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.15",
    "typescript": "5.8.3"
  }
}
